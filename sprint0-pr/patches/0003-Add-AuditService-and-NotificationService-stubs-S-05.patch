--- /dev/null
+++ b/adminpanel/services.py
@@ -0,0 +1,75 @@
+"""AuditService (S-05): the single place that writes audit/activity records.
+
+SAD 4.3: AuditService.record(actor, action, target, timestamp) creates an immutable
+record; timestamps are stored in UTC. SAD 4.4: callers write the audit record inside
+the same database transaction as the change it describes.
+"""
+
+import re
+from datetime import UTC, datetime
+
+from .models import AuditRecord
+
+# Stable action names look like "task.created" or "task.status_changed".
+ACTION_PATTERN = re.compile(r"^[a-z][a-z_]*(\.[a-z][a-z_]*)+$")
+
+# Detail keys containing any of these are never stored (docs/schema.md: no secrets).
+SENSITIVE_KEY_PARTS = ("password", "token", "secret", "authorization", "cookie", "session")
+REDACTED = "[redacted]"
+
+
+def _scrub(value):
+    """Return a copy of `value` with the values of sensitive-looking keys replaced."""
+    if isinstance(value, dict):
+        return {
+            key: REDACTED
+            if any(part in str(key).lower() for part in SENSITIVE_KEY_PARTS)
+            else _scrub(item)
+            for key, item in value.items()
+        }
+    if isinstance(value, (list, tuple)):
+        return [_scrub(item) for item in value]
+    return value
+
+
+def _target_parts(target):
+    """Accept a model instance or a (type, id) pair; return (target_type, target_id)."""
+    if hasattr(target, "pk") and hasattr(target, "_meta"):
+        if target.pk is None:
+            raise ValueError("Audit target must be saved before it is recorded.")
+        return target._meta.model_name, str(target.pk)
+    try:
+        target_type, target_id = target
+    except (TypeError, ValueError):
+        raise ValueError("Audit target must be a model instance or a (type, id) pair.") from None
+    return str(target_type), str(target_id)
+
+
+class AuditService:
+    @staticmethod
+    def record(actor, action, target, timestamp=None, details=None):
+        """Append one audit record and return it.
+
+        actor      -- the acting user, or None for a system action.
+        action     -- stable dotted name, e.g. "task.created".
+        target     -- the affected model instance, or a (type, id) pair.
+        timestamp  -- timezone-aware datetime (stored in UTC); defaults to now.
+        details    -- optional dict; values under password/token/secret-like keys are redacted.
+        """
+        if not ACTION_PATTERN.match(action or ""):
+            raise ValueError(f"Invalid audit action name: {action!r}")
+        if actor is not None and not getattr(actor, "pk", None):
+            raise ValueError("Audit actor must be a saved user or None.")
+        if timestamp is None:
+            timestamp = datetime.now(UTC)
+        elif timestamp.tzinfo is None:
+            raise ValueError("Audit timestamp must be timezone-aware.")
+        target_type, target_id = _target_parts(target)
+        return AuditRecord.objects.create(
+            actor=actor,
+            action=action,
+            target_type=target_type,
+            target_id=target_id,
+            created_at=timestamp.astimezone(UTC),
+            details=_scrub(details or {}),
+        )
diff --git a/notif/services.py b/notif/services.py
new file mode 100644
index 0000000..a219e57
--- /dev/null
+++ b/notif/services.py
@@ -0,0 +1,91 @@
+"""NotificationService (S-05): thin working stub for the notification interface.
+
+SAD 4.3: NotificationService.enqueue/send(event) accepts a domain event and delivers
+it. This stub keeps pending events in memory and sends them as e-mail through Django's
+mail layer (MailHog in development). It is deliberately small:
+
+- enqueue(event)        queue an event for later delivery
+- send(event)           deliver one event now; returns True/False and never raises, so a
+                        mail-server problem cannot break the request that triggered it
+- deliver_pending()     send everything queued (for a later scheduled command)
+
+Not done yet (later notification stories): a persisted Notification table that survives
+restarts, retry/back-off, and due-date reminders. See DEVIATIONS.md.
+"""
+
+import logging
+from collections import deque
+from dataclasses import dataclass, field
+
+from django.conf import settings
+from django.core.mail import send_mail
+
+logger = logging.getLogger(__name__)
+
+_pending = deque()
+
+
+@dataclass(frozen=True)
+class NotificationEvent:
+    kind: str  # stable name such as "task.assigned"
+    recipient: object  # a user with an e-mail address
+    subject: str
+    body: str
+    context: dict = field(default_factory=dict)
+
+
+class NotificationService:
+    @staticmethod
+    def enqueue(event):
+        """Queue an event for delivery and return it."""
+        if not isinstance(event, NotificationEvent):
+            raise TypeError("enqueue() needs a NotificationEvent.")
+        _pending.append(event)
+        return event
+
+    @staticmethod
+    def pending():
+        """The events waiting for delivery, oldest first (a copy)."""
+        return list(_pending)
+
+    @staticmethod
+    def clear():
+        """Drop all queued events (used by tests)."""
+        _pending.clear()
+
+    @staticmethod
+    def send(event):
+        """Deliver one event by e-mail. True on success, False on failure; never raises."""
+        recipient_email = getattr(event.recipient, "email", "")
+        if not recipient_email:
+            logger.warning("notification skipped kind=%s: recipient has no e-mail", event.kind)
+            return False
+        try:
+            send_mail(
+                event.subject,
+                event.body,
+                getattr(settings, "DEFAULT_FROM_EMAIL", None),
+                [recipient_email],
+                fail_silently=False,
+            )
+        except Exception as exc:  # delivery problems must not break the caller
+            # Log the exception type only: its message could echo connection details.
+            logger.warning(
+                "notification failed kind=%s recipient_id=%s error=%s",
+                event.kind,
+                getattr(event.recipient, "pk", None),
+                type(exc).__name__,
+            )
+            return False
+        return True
+
+    @classmethod
+    def deliver_pending(cls):
+        """Send every queued event. Returns (sent_count, failed_count)."""
+        sent = failed = 0
+        while _pending:
+            if cls.send(_pending.popleft()):
+                sent += 1
+            else:
+                failed += 1
+        return sent, failed
diff --git a/tests/foundation/test_audit_service.py b/tests/foundation/test_audit_service.py
new file mode 100644
index 0000000..7e5457b
--- /dev/null
+++ b/tests/foundation/test_audit_service.py
@@ -0,0 +1,106 @@
+"""S-05: AuditService and the append-only audit record."""
+
+from datetime import UTC, datetime, timedelta, timezone
+
+import pytest
+
+from adminpanel.models import AuditImmutableError, AuditRecord
+from adminpanel.services import AuditService
+from tasks.models import Task
+
+pytestmark = pytest.mark.django_db
+
+
+@pytest.fixture
+def task(make_user):
+    return Task.objects.create(owner=make_user(), title="t")
+
+
+def test_record_writes_a_row_for_a_model_target(make_user, task):
+    actor = make_user()
+    record = AuditService.record(actor, "task.created", task, details={"priority": "high"})
+    record.refresh_from_db()
+    assert record.actor == actor
+    assert record.action == "task.created"
+    assert record.target_type == "task"
+    assert record.target_id == str(task.pk)
+    assert record.details == {"priority": "high"}
+
+
+def test_record_accepts_a_type_and_id_pair():
+    record = AuditService.record(None, "user.login_failed", ("user", 7))
+    assert (record.target_type, record.target_id, record.actor) == ("user", "7", None)
+
+
+def test_timestamp_defaults_to_now_in_utc():
+    before = datetime.now(UTC)
+    record = AuditService.record(None, "system.job_ran", ("job", "x"))
+    assert before <= record.created_at <= datetime.now(UTC) + timedelta(seconds=1)
+    assert record.created_at.utcoffset() == timedelta(0)
+
+
+def test_given_timestamp_is_stored_as_utc():
+    ist = timezone(timedelta(hours=5, minutes=30))
+    record = AuditService.record(None, "system.job_ran", ("job", "x"),
+                                 timestamp=datetime(2026, 10, 15, 12, 0, tzinfo=ist))
+    record.refresh_from_db()
+    assert record.created_at == datetime(2026, 10, 15, 6, 30, tzinfo=UTC)
+
+
+def test_naive_timestamp_is_rejected():
+    with pytest.raises(ValueError):
+        AuditService.record(None, "system.job_ran", ("job", "x"), timestamp=datetime(2026, 1, 1))
+
+
+@pytest.mark.parametrize("bad", ["", "created", "Task.Created", "task..created", "task.created!"])
+def test_invalid_action_names_are_rejected(bad):
+    with pytest.raises(ValueError):
+        AuditService.record(None, bad, ("task", 1))
+
+
+def test_unsaved_target_is_rejected(make_user):
+    with pytest.raises(ValueError):
+        AuditService.record(None, "task.created", Task(owner=make_user(), title="x"))
+
+
+def test_secrets_in_details_are_redacted(task):
+    record = AuditService.record(
+        None, "user.updated", task,
+        details={"password": "hunter2", "nested": {"reset_token": "abc"}, "status": "done"},
+    )
+    assert record.details == {
+        "password": "[redacted]", "nested": {"reset_token": "[redacted]"}, "status": "done",
+    }
+
+
+def test_existing_row_cannot_be_modified(task):
+    record = AuditService.record(None, "task.created", task)
+    record.action = "task.deleted"
+    with pytest.raises(AuditImmutableError):
+        record.save()
+    record.refresh_from_db()
+    assert record.action == "task.created"
+
+
+def test_rows_cannot_be_deleted_or_bulk_changed(task):
+    record = AuditService.record(None, "task.created", task)
+    with pytest.raises(AuditImmutableError):
+        record.delete()
+    with pytest.raises(AuditImmutableError):
+        AuditRecord.objects.all().delete()
+    with pytest.raises(AuditImmutableError):
+        AuditRecord.objects.all().update(action="x.y")
+    assert AuditRecord.objects.count() == 1
+
+
+def test_audit_service_can_be_called_from_a_view(client, make_user, task):
+    """Done-when: callable from a view as well as from a test."""
+    from django.http import HttpResponse
+    from django.test import RequestFactory
+
+    def view(request):
+        AuditService.record(None, "task.viewed", task)
+        return HttpResponse("ok")
+
+    assert view(RequestFactory().get("/")).status_code == 200
+    assert AuditRecord.objects.filter(action="task.viewed").count() == 1
