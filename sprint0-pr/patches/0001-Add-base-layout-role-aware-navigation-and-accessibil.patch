--- /dev/null
+++ b/templates/base.html
@@ -0,0 +1,49 @@
+{% load static %}<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>{% block title %}Task Manager{% endblock %} | Task Manager</title>
+  <link rel="stylesheet" href="{% static 'css/app.css' %}">
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+
+  <header class="site-header">
+    <div class="container header-inner">
+      <a class="brand" href="/">Task Manager</a>
+      <nav aria-label="Main">
+        <ul class="nav-list">
+          {% for item in nav_items %}
+            <li>
+              {% if item.post %}
+                <form method="post" action="{{ item.url }}" class="nav-form">
+                  {% csrf_token %}
+                  <button type="submit" class="nav-link nav-button">{{ item.label }}</button>
+                </form>
+              {% else %}
+                <a class="nav-link" href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>
+              {% endif %}
+            </li>
+          {% endfor %}
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" class="container" tabindex="-1">
+    {% if messages %}
+      <div class="messages" role="status">
+        {% for message in messages %}
+          <p class="message message--{{ message.level_tag }}">{{ message }}</p>
+        {% endfor %}
+      </div>
+    {% endif %}
+    {% block content %}{% endblock %}
+  </main>
+
+  <footer class="site-footer">
+    <div class="container">Task Manager Application</div>
+  </footer>
+</body>
+</html>
